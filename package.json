{
  "name": "modelhub-ai-gateway",
  "version": "0.7.46",
  "private": true,
  "main": "main.js",
  "description": "Local multi-provider model aggregator with GUI control panel",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "test": "node --test test/server.test.js",
    "lint": "eslint .",
    "format": "prettier --write \"*.js\" \"server/**/*.js\" \"renderer/*.js\" \"test/**/*.js\"",
    "dist": "electron-builder -p never"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "prettier": "^3.9.6"
  },
  "build": {
    "appId": "local.modelhub.app",
    "productName": "ModelHub",
    "directories": {
      "output": "dist"
    },
    "asar": false,
    "files": [
      "main.js",
      "server.js",
      "server/**/*",
      "renderer/**/*",
      "icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.png",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "quadrellif90-collab <noreply@github.com>",
      "category": "Development"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "author": {
    "name": "quadrellif90-collab",
    "email": "noreply@github.com"
  }
}
