{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2021",
    "lib": ["es2021", "dom"],
    "checkJs": false,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "server/*": ["server/*"]
    }
  },
  "include": ["*.js", "server/**/*.js", "renderer/*.js", "test/**/*.js"],
  "exclude": ["node_modules", "dist"]
}
